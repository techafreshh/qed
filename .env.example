# Copy to .env and fill in real values. Never commit .env.
# Secrets — never commit real values, never log them.
META_API_KEY=
# Secrets — never commit real values, never log them.
MODAL_TOKEN=
# Offline mode (default 1). Set to 0 to go live.
QED_OFFLINE=1
# Codegen backend (default llama_direct).
QED_CODEGEN_BACKEND=llama_direct
# Muse model (default muse-spark-1.3-contributor).
# QED_MUSE_MODEL=muse-spark-1.3-contributor
# Meta Model API endpoint override (default https://api.llama.com/v1/chat/completions).
# META_API_URL=https://api.llama.com/v1/chat/completions
